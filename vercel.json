{
  "headers": [
    {
      "source": "/_pages/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/site-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?p=home"
    },
    {
      "source": "/:p(about|privacy-policy|football-matches-today|real-madrid-live-score|soccer-live-scores|world-cup-2026-live-scores|champions-league-live-scores|europa-league-live-scores|conference-league-live-scores|nations-league-live-scores|premier-league-live-scores|la-liga-live-scores|serie-a-live-scores|bundesliga-live-scores|ligue-1-live-scores|mls-live-scores|saudi-pro-league-live-scores|fa-cup-live-scores)",
      "destination": "/api/page?p=:p"
    },
    {
      "source": "/:p(about|privacy-policy|football-matches-today|real-madrid-live-score|soccer-live-scores|world-cup-2026-live-scores|champions-league-live-scores|europa-league-live-scores|conference-league-live-scores|nations-league-live-scores|premier-league-live-scores|la-liga-live-scores|serie-a-live-scores|bundesliga-live-scores|ligue-1-live-scores|mls-live-scores|saudi-pro-league-live-scores|fa-cup-live-scores)/",
      "destination": "/api/page?p=:p"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "_pages/**",
      "maxDuration": 15
    }
  }
}